[96m\u2551\u001b[0m                   \u001b[1;31m \u2588\u2588\u2551\u255a\u2588\u2588\u2554\u255d\u2588\u2588\u2551\u2588\u2588\u2554\u2550\u2550\u2588\u2588\u2551\u2588\u2588\u2551  \u2588\u2588\u2551\u2588\u2588\u2554\u2550\u2550\u2588\u2588\u2551\u2588\u2588\u2554\u2550\u2550\u2588\u2588\u2557\u2588\u2588\u2554\u2550\u2550\u2588\u2588\u2551\u001b[0m                          \u001b[96m\u2551\u001b[0m\r\n\u001b[96m\u2551\u001b[0m                   \u001b[1;31m \u2588\u2588\u2551 \u255a\u2550\u255d \u2588\u2588\u2551\u2588\u2588\u2551  \u2588\u2588\u2551\u2588\u2588\u2588\u2588\u2588\u2588\u2554\u255d\u2588\u2588\u2551  \u2588\u2588\u2551\u2588\u2588\u2551  \u2588\u2588\u2551\u2588\u2588\u2551  \u2588\u2588\u2551\u001b[0m                          \u001b[96m\u2551\u001b[0m\r\n\u001b[96m\u2551\u001b[0m                   \u001b[1;31m \u255a\u2550\u255d     \u255a\u2550\u255d\u255a\u2550\u255d  \u255a\u2550\u255d\u255a\u2550\u2550\u2550\u2550\u2550\u255d \u255a\u2550\u255d  \u255a\u2550\u255d\u255a\u2550\u255d  \u255a\u2550\u255d\u255a\u2550\u255d  \u255a\u2550\u255d\u001b[0m                          \u001b[96m\u2551\u001b[0m\r\n\u001b[96m\u2551\u001b[0m                   \u001b[1;31m       \u2588\u2588\u2588\u2557   \u2588\u2588\u2588\u2557 \u2588\u2588\u2588\u2588\u2588\u2557 \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2557\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2557\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2557\u2588\u2588\u2588\u2588\u2588\u2588\u2557\u001b[0m                    \u001b[96m\u2551\u001b[0m\r\n\u001b[96m\u2551\u001b[0m                   \u001b[1;31m       \u2588\u2588\u2588\u2588\u2557 \u2588\u2588\u2588\u2588\u2551\u2588\u2588\u2554\u2550\u2550\u2588\u2588\u2557\u2588\u2588\u2554\u2550\u2550\u2550\u2550\u255d\u255a\u2550\u2550\u2588\u2588\u2554\u2550\u2550\u255d\u2588\u2588\u2554\u2550\u2550\u2550\u2550\u255d\u2588\u2588\u2554\u2550\u2550\u2588\u2588\u2557\u001b[0m                   \u001b[96m\u2551\u001b[0m\r\n\u001b[96m\u2551\u001b[0m                   \u001b[1;31m       \u2588\u2588\u2554\u2588\u2588\u2588\u2588\u2554\u2588\u2588\u2551\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2551\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2557   \u2588\u2588\u2551   \u2588\u2588\u2588\u2588\u2588\u2557  \u2588\u2588\u2588\u2588\u2588\u2588\u2554\u255d\u001b[0m                   \u001b[96m\u2551\u001b[0m\r\n\u001b[96m\u2551\u001b[0m                   \u001b[1;31m       \u2588\u2588\u2551\u255a\u2588\u2588\u2554\u255d\u2588\u2588\u2551\u2588\u2588\u2554\u2550\u2550\u2588\u2588\u2551\u255a\u2550\u2550\u2550\u2550\u2588\u2588\u2551   \u2588\u2588\u2551   \u2588\u2588\u2554\u2550\u2550\u255d  \u2588\u2588\u2554\u2550\u2550\u2588\u2588\u2557\u001b[0m                   \u001b[96m\u2551\u001b[0m\r\n\u001b[96m\u2551\u001b[0m                   \u001b[1;31m       \u2588\u2588\u2551 \u255a\u2550\u255d \u2588\u2588\u2551\u2588\u2588\u2551  \u2588\u2588\u2551\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2551   \u2588\u2588\u2551   \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2557\u2588\u2588\u2551  \u2588\u2588\u2551\u001b[0m                   \u001b[96m\u2551\u001b[0m\r\n\u001b[96m\u2551\u001b[0m                   \u001b[1;31m       \u255a\u2550\u255d     \u255a\u2550\u255d\u255a\u2550\u255d  \u255a\u2550\u255d\u255a\u2550\u2550\u2550\u2550\u2550\u2550\u255d   \u255a\u2550\u255d   \u255a\u2550\u2550\u2550\u2550\u2550\u2550\u255d\u255a\u2550\u255d  \u255a\u2550\u255d\u001b[0m                   \u001b[96m\u2551\u001b[0m\r\n\u001b[96m\u2551\u001b[0m                                                                                                 \u001b[96m\u2551\u001b[0m\r\n\u001b[96m\u2551\u001b[0m                   \u001b[1;31m   MadaraMaster v5.0.0 \u2022 Created by jaimefg1888\u001b[0m                               \u001b[96m\u2551\u001b[0m\r\n\u001b[96m\u2551\u001b[0m                                                                                                 \u001b[96m\u2551\u001b[0m\r\n\u001b[96m\u255a\u2550\u001b[0m\u001b[96m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\u001b[96m \u001b[0m\u001b[2;96mNIST SP 800-88 \u00b7 DoD 5220.22-M \u00b7 v5.0.0\u001b[0m\u001b[96m \u001b[0m\u001b[96m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\u001b[96m\u2550\u255d\u001b[0m\r\n\r\n                                                                                   \r\n \u001b[1;36m  \u001b[0m\u001b[1;36mTarget          \u001b[0m\u001b[1;36m  \u001b[0m \u001b[37m  \u001b[0m\u001b[37m/tmp/madara-demo-wd2q6i9x/secret-project                \u001b[0m\u001b[37m  \u001b[0m \r\n \u001b[1;36m  \u001b[0m\u001b[1;36mType            \u001b[0m\u001b[1;36m  \u001b[0m \u001b[37m  \u001b[0m\u001b[37mDirectory (recursive)                                   \u001b[0m\u001b[37m  \u001b[0m \r\n \u001b[1;36m  \u001b[0m\u001b[1;36mFiles to wipe   \u001b[0m\u001b[1;36m  \u001b[0m \u001b[37m  \u001b[0m\u001b[37m5                                                       \u001b[0m\u001b[37m  \u001b[0m \r\n \u001b[1;36m  \u001b[0m\u001b[1;36mTotal data      \u001b[0m\u001b[1;36m  \u001b[0m \u001b[37m  \u001b[0m\u001b[37m120.0 MB                                                \u001b[0m\u001b[37m  \u001b[0m \r\n \u001b[1;36m  \u001b[0m\u001b[1;36mMethod          \u001b[0m\u001b[1;36m  \u001b[0m \u001b[37m  \u001b[0m\u001b[37mAsync Auto-Detect (Standard: purge)                     \u001b[0m\u001b[37m  \u001b[0m \r\n \u001b[1;36m  \u001b[0m\u001b[1;36mVerify          \u001b[0m\u001b[1;36m  \u001b[0m \u001b[37m  \u001b[0m\u001b[37mYes                                                     \u001b[0m\u001b[37m  \u001b[0m \r\n \u001b[1;36m  \u001b[0m\u001b[1;36mHash before wipe\u001b[0m\u001b[1;36m  \u001b[0m \u001b[37m  \u001b[0m\u001b[37mNo                                                      \u001b[0m\u001b[37m  \u001b[0m \r\n \u001b[1;36m  \u001b[0m\u001b[1;36mAudit Log       \u001b[0m\u001b[1;36m  \u001b[0m \u001b[37m  \u001b[0m\u001b[37m/tmp/madara-demo-wd2q6i9x/state/madaramaster/audit.jsonl\u001b[0m\u001b[37m  \u001b[0m \r\n                                                                                   \r\n  \u001b[2mThe purge standard always verifies after wiping.\u001b[0m\r\n\r\n\u001b[91m\u2554\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2557\u001b[0m\r\n\u001b[91m\u2551\u001b[0m                                                                                                 \u001b[91m\u2551\u001b[0m\r\n\u001b[91m\u2551\u001b[0m  \u001b[1;31m\u26a0 WARNING: THIS ACTION IS IRREVERSIBLE \u26a0\u001b[0m                                                       \u001b[91m\u2551\u001b[0m\r\n\u001b[91m\u2551\u001b[0m                                                                                                 \u001b[91m\u2551\u001b[0m\r\n\u001b[91m\u2551\u001b[0m  All targeted files will be overwritten (1 to 3 passes depending on the                         \u001b[91m\u2551\u001b[0m\r\n\u001b[91m\u2551\u001b[0m  standard and the storage type) and permanently deleted.                                        \u001b[91m\u2551\u001b[0m\r\n\u001b[91m\u2551\u001b[0m  \u001b[1mData CANNOT be recovered after this operation.\u001b[0m                                                 \u001b[91m\u2551\u001b[0m\r\n\u001b[91m\u25