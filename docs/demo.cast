[5.7337, "o", "\u001b[91m\u2554\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2557\u001b[0m\r\n\u001b[91m\u2551\u001b[0m                                                                                                 \u001b[91m\u2551\u001b[0m\r\n\u001b[91m\u2551\u001b[0m  \u001b[1;31m\u26a0 WARNING: THIS ACTION IS IRREVERSIBLE \u26a0\u001b[0m                                                       \u001b[91m\u2551\u001b[0m\r\n\u001b[91m\u2551\u001b[0m                                                                                                 \u001b[91m\u2551\u001b[0m\r\n\u001b[91m\u2551\u001b[0m  All targeted files will be overwritten (1 to 3 passes depending on the                         \u001b[91m\u2551\u001b[0m\r\n\u001b[91m\u2551\u001b[0m  standard and the storage type) and permanently deleted.                                        \u001b[91m\u2551\u001b[0m\r\n\u001b[91m\u2551\u001b[0m  \u001b[1mData CANNOT be recovered after this operation.\u001b[0m                                                 \u001b[91m\u2551\u001b[0m\r\n\u001b[91m\u2551\u001b[0m                                                                                                 \u001b[91m\u2551\u001b[0m\r\n\u001b[91m\u255a\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550